{
  "functions": {
    "api/ncaa.js": {
      "maxDuration": 60
    },
    "api/alerts.js": {
      "maxDuration": 60
    },
    "api/team.js": {
      "includeFiles": "{index.html,teams.js}"
    },
    "api/sitemap.js": {
      "includeFiles": "{teams.js,season.json}"
    },
    "api/recap.js": {
      "includeFiles": "season.json",
      "maxDuration": 30
    }
  },
  "redirects": [
    {
      "source": "/((?!api/).*)",
      "has": [
        {
          "type": "host",
          "value": "college-basketball-site.vercel.app"
        }
      ],
      "destination": "https://collegebasketball.news/$1",
      "permanent": true
    }
  ],
  "rewrites": [
    {
      "source": "/team/:slug",
      "destination": "/api/team?slug=:slug"
    },
    {
      "source": "/game/:id/:slug",
      "destination": "/api/recap?id=:id"
    },
    {
      "source": "/game/:id",
      "destination": "/api/recap?id=:id"
    },
    {
      "source": "/sitemap.xml",
      "destination": "/api/sitemap"
    }
  ]
}